# /etc/zigbox-ci/ci.env: what bootstrap.sh and compose.yaml read (ops/ci/README.md).
# Not secret. The secrets are files beside it: github-client-id, github-client-secret (0640,
# group 1000, the server's uid; from the GitHub OAuth app) and agent-secret (bootstrap.sh makes it).

# The DNS name that points at this box; Caddy gets its certificate. The OAuth app's callback is
# https://<CI_HOST>/authorize.
CI_HOST=ci.zigbox.org
# GitHub logins that administer Woodpecker (comma separated). Only an admin can mark a repository
# Trusted, which the VM demos need (/dev/kvm and the cache mount).
CI_ADMINS=your-github-login
# Only members of this GitHub organisation may log in.
CI_GITHUB_ORG=ZigboxOrg
# Workflows the agent runs at once. Each VM demo boots a guest of about 2 vCPUs and 4 GiB; the box
# has 8 cores, 16 threads and 64 GiB and also runs the simulation fleet.
CI_MAX_WORKFLOWS=3
CI_AGENT_NAME=fleet-1
