# /etc/zigbox-backup/backup.env: what bootstrap.sh and sync.sh read (ops/backup/README.md). Not
# secret. The secrets are files beside it: github-token (read-only, asked for by bootstrap.sh),
# forgejo-token and forgejo-secrets.env (bootstrap.sh makes them).

# The DNS name that points at this box; Forgejo gets its Let's Encrypt certificate for it.
BACKUP_HOST=git.zigbox.org
# The Forgejo admin (bootstrap.sh creates the user) and the e-mail Let's Encrypt writes to.
BACKUP_ADMIN=
BACKUP_EMAIL=
# The GitHub repositories to copy, OWNER/NAME separated by spaces; each lands under the same name.
BACKUP_REPOS="ZigboxOrg/zigbox ZigboxOrg/zigcube"
# Branch prefixes not copied (scratch branches), separated by spaces.
BACKUP_SKIP="vm/"
